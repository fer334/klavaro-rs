comment-basic-next =
    Oso ondo, oraintxe lortu duzu!
    Zoaz hurrengo ikasgaira.
comment-basic-done =
    Zorionak!
    Oinarrizko ikastaro osoa burutu duzu.
    Zoaz hurrengo ariketa motara: moldagarritasuna.
    Batez ere zehaztasuna izango da hemen landuko duzun abilezia.
comment-adapt-try-again =
    Zure zehaztasun indizea { $target }% azpitik dago...
    Saiatuko zara, mesedez, hori hobetzen?
comment-adapt-improving =
    Ondo ari zara. Baina...
    Saiatuko zara zehaztasun indizea { $target }% mugaraino hobetzen?
comment-adapt-almost =
    Hortxe-hortxe zaude baina zure zehaztasun indizea oraindik { $target }% azpitik dabil.
    Egin itzazu saio berri bakar batzuk edo agian asper-asper eginda zaude... Behar bada hobe zenuke beste ariketa mota batera jotzea.
comment-adapt-done =
    Bikain!
    Arrakasta handia lortu duzu. { $target }% gainetiko zehaztasuna!
    Orain zure lastertasuna hobetzeko garaia da.
    Zoaz hirugarren ariketara menu nagusian.
comment-velo-beginning =
    Hasi berria zara.
    Pazientzia beharko duzu, saia zaitez egunero, hartu atsedena eta ez zaitez gehiegi kezkatu:
    praktikak eta jarraikitasunak zure lastertasuna hobetuko dute.
comment-velo-highway =
    Oraindik ez gara autopistan sartu. Hobeto egin dezakezu...
    Saia zaitez lortzen gutxienez { $target } hitz minutuko.
comment-velo-faster =
    Ondo ari zara baina azkarrago beharko zenuke.
    Eta ez ahaztu zehaztasuna. Saia zaitez { $target } hitz minutuko lortzen.
comment-velo-running =
    Ongi. Orain korrika egiten hasi beharko.
    Irits zintezke { $target } hitz minutuko lastertasuneraino?
comment-velo-almost =
    Oso ongi. Hortxe-hortxe zaude.
    Azkenik, irits zintezke { $target } hitz minutuko lastertasuna lortzeraino?
comment-velo-enough =
    Bikain. Ikastaro honi dagokionez, nahikoa da.
    Saiatuko zara orain jariakortasun ariketekin?
comment-velo-professional =
    Azkar! Honetan profesionala zara?
    Bada, saia zaitez { $target } hitz minutuko lortzen!
comment-velo-speed-racer = Estatistika onak, Speedy Gonzales! Ez zara ausartuko { $target } hitz minutuko lortzen?
comment-velo-kung-fu =
    Shaolin botereak!
    Oraindik hobeto egin dezakezu { $target } hitz minutuko?
comment-velo-master =
    Dvorak jenioa!
    Ez dut hitzik zenbat miresten zaitudan adierazteko!
comment-fluid-too-slow =
    Zehatz mekanografiatu duzu baina ez horren azkar.
    Irits zintezke { $target } hitz minutuko mugaraino?
comment-fluid-irregular =
    Zeure erritmoa ez da hain jarraikia. Lasai.
    Hemendik aurrera, saia zaitez jariakortasuna { $target }% honetatik gora eusten.
comment-fluid-almost =
    Hortxe-hortxe duzu helmuga. Saia zaitez jariakortasun handiagoz mekanografiatzen.
    Zure jariakortasuna { $target }% baino hobea izatea nahi nuke.
comment-fluid-congratulations =
    Zorionak!
    Profesionala ematen duzu.
    Ez duzu dagoeneko programa honen (nire) beharrik.
    Ikasten edota hobetzen ondo pasatu duzu? Hala espero dut. Mila esker eta izan zoriontsu!
comment-fluid-beyond =
    Nola lortu duzu hain azkar mekanografiatzea?
    Nik uste baino urrutiago iritsi zara, benetan.
    Ez zara, bada, makina bat izango, ezta? Irakatsiko zenidake?
    Nik behintzat ezin dizut zuri dagoeneko ezer irakatsi. Zoaz aditu batengana!
